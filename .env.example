# Copy this file to .env (never commit .env) and fill in the values.
#   Linux/Mac:  cp .env.example .env      Windows: copy .env.example .env

# ── Database ──────────────────────────────────────────────
# Strong password: 16+ characters of letters, digits and - _ . Avoid $ " ' ; = and spaces (it goes into a connection string).
DB_PASSWORD=ChangeMe-Str0ng-Password

# ── Website address ───────────────────────────────────────
# Production: your domain, e.g. SITE_ADDRESS=dollarshark.duckdns.org and SITE_URL=https://dollarshark.duckdns.org
# Local test: SITE_ADDRESS=:80  SITE_URL=http://localhost:8088  HTTP_PORT=8088  HTTPS_PORT=8443  HTTPS_REDIRECT=false
# (HTTPS_REDIRECT=false also allows login cookies over plain http — local testing only, never on the server)
SITE_ADDRESS=dollarshark.example.com
SITE_URL=https://dollarshark.example.com
HTTP_PORT=80
HTTPS_PORT=443
HTTPS_REDIRECT=true

# ── Email (confirmation + password reset) ─────────────────
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME/SMTP_FROM = your Gmail, SMTP_PASSWORD = 16-char App Password
# Local test with Mailpit: SMTP_HOST=mailpit SMTP_PORT=1025 SMTP_ENABLE_SSL=false SMTP_FROM=no-reply@dollarshark.local
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=you@gmail.com

# ── Backups (database + statement files, every night) ─────
# Archives are encrypted with this passphrase. SAVE IT IN YOUR PASSWORD MANAGER: without it no backup can be restored.
# Long and random, no spaces or quotes, e.g. from: openssl rand -base64 32
BACKUP_PASSPHRASE=
# Daily time in UTC (08:00 UTC = 3–4 am Toronto). The newest BACKUP_KEEP_LOCAL archives stay on the server.
BACKUP_TIME_UTC=08:00
BACKUP_KEEP_LOCAL=7
# Off-server copy in AWS S3 (docs/deployment.md → Backups). Leave empty to keep backups on the server only.
BACKUP_S3_BUCKET=
BACKUP_AWS_REGION=us-east-2
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=

# ── Optional: Continue with Google ────────────────────────
# Redirect URI to register in Google Cloud: https://<your-domain>/signin-google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
